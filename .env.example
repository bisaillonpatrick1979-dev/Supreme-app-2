# =============================================================================
# HailiteManager - Environment Variables
# Copy this file to .env.local and fill in all values.
# NEVER commit .env.local to git.
# =============================================================================

# ─── SUPABASE ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIs...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIs...

# ─── GOOGLE CLOUD STORAGE ────────────────────────────────────────────────────
NEXT_PUBLIC_GCS_BUCKET=hailite-xteriors-photos
GCS_PROJECT_ID=hailite-manager-prod
GCS_SERVICE_ACCOUNT_EMAIL=service-account@hailite-manager.iam.gserviceaccount.com
# Paste the full JSON key as a single-line string (escape quotes)
GCS_SERVICE_ACCOUNT_KEY={"type":"service_account",...}

# ─── STRIPE ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxx
STRIPE_SECRET_KEY=sk_test_xxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxx

# ─── GOOGLE MAPS ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=AIzaSyDxxxxx

# ─── APP CONFIG ───────────────────────────────────────────────────────────────
# Development:  http://localhost:3000
# Production:   https://hailite-manager.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
